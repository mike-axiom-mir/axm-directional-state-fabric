{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/directional-state/transition.schema.json",
  "title": "AXM Directional State Proposed Transition",
  "description": "Experimental proposal contract. A proposal describes intended state movement; acceptance is derived from current state and root-grounded evaluation rather than actor category.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "base_revision",
    "actor_ref",
    "intent",
    "mutations",
    "declared_uncertainties"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "purpose_ref": {
      "type": ["string", "null"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": true
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mutation" }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "declared_uncertainties": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reversibility": {
      "type": "string",
      "enum": ["reversible", "partially_reversible", "irreversible", "unknown"],
      "default": "unknown"
    },
    "requested_timing": {
      "type": "string",
      "enum": ["immediate", "normal", "can_defer"],
      "default": "normal"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "operation", "path"],
      "properties": {
        "target_ref": { "type": "string", "minLength": 1 },
        "operation": {
          "type": "string",
          "enum": [
            "set",
            "add",
            "remove",
            "relate",
            "unrelate",
            "create",
            "retire"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "value": {},
        "relationship_type": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    }
  }
}
